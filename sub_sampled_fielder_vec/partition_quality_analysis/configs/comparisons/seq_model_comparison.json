{
  "name": "seq_model_comparison",
  "description": "Compare partition quality across different sequence evolution models",
  "base_config": {
    "tree": {
      "model": "balanced_binary",
      "params": {
        "num_taxa": 128,
        "edge_length": 1.0
      }
    },
    "sequence": {
      "len": 1000,
      "params": {
        "mutation_rate": 0.1,
        "seed": 42
      }
    },
    "partition": {
      "num_gaps": 1,
      "min_split": 2
    }
  },
  "sweep": {
    "parameter": "sequence.model",
    "values": ["JC69", "HKY", "TN93"],
    "param_overrides": {
      "JC69": {
        "num_classes": 4
      },
      "HKY": {
        "kappa": 2.5,
        "stationary_freqs": [0.3, 0.2, 0.2, 0.3]
      },
      "TN93": {
        "stationary_freqs": [0.25, 0.25, 0.25, 0.25],
        "kappa1": 2.0,
        "kappa2": 2.0
      }
    }
  },
  "output": {
    "dir": "results/comparisons/seq_model_comparison",
    "save_individual_matrices": false
  }
}

