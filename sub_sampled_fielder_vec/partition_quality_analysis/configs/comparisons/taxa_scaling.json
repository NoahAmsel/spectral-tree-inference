{
  "name": "taxa_scaling",
  "description": "Compare partition quality across different numbers of taxa",
  "base_config": {
    "tree": {
      "model": "balanced_binary",
      "params": {
        "edge_length": 1.0
      }
    },
    "sequence": {
      "model": "JC69",
      "len": 1000,
      "params": {
        "mutation_rate": 0.1,
        "num_classes": 4,
        "seed": 42
      }
    },
    "partition": {
      "num_gaps": 1,
      "min_split": 2
    }
  },
  "sweep": {
    "parameter": "tree.params.num_taxa",
    "values": [512, 1024, 2048, 4096, 8192]
  },
  "output": {
    "dir": "results/comparisons/taxa_scaling",
    "save_individual_matrices": false
  }
}

