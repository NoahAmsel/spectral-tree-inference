{
  "name": "tree_model_comparison",
  "description": "Compare partition quality across different tree models",
  "base_config": {
    "tree": {
      "params": {
        "num_taxa": 128,
        "edge_length": 1.0
      }
    },
    "sequence": {
      "model": "JC69",
      "len": 1000,
      "params": {
        "mutation_rate": 0.1,
        "num_classes": 4,
        "seed": 42
      }
    },
    "partition": {
      "num_gaps": 1,
      "min_split": 2
    }
  },
  "sweep": {
    "parameter": "tree.model",
    "values": ["balanced_binary", "lopsided", "kingman_pure"]
  },
  "output": {
    "dir": "results/comparisons/tree_model_comparison",
    "save_individual_matrices": false
  }
}

