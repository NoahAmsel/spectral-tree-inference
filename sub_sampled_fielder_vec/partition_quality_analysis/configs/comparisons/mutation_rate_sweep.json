{
  "name": "mutation_rate_sweep",
  "description": "Compare partition quality across mutation rates",
  "base_config": {
    "tree": {
      "model": "balanced_binary",
      "params": {
        "num_taxa": 1024,
        "edge_length": 1.0
      }
    },
    "sequence": {
      "model": "JC69",
      "len": 5000,
      "params": {
        "num_classes": 4,
        "seed": 42
      }
    },
    "partition": {
      "num_gaps": 1,
      "min_split": 2
    }
  },
  "sweep": {
    "parameter": "sequence.params.mutation_rate",
    "values": [0.1, 0.2, 0.3, 0.5,0.7,0.9]
  },
  "output": {
    "dir": "results/comparisons/mutation_rate_sweep",
    "save_individual_matrices": false
  }
}

