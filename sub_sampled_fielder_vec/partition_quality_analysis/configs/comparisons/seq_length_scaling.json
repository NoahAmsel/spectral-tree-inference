{
  "name": "seq_length_scaling",
  "description": "Compare partition quality across different sequence lengths",
  "base_config": {
    "tree": {
      "model": "balanced_binary",
      "params": {
        "num_taxa": 1024,
        "edge_length": 1.0
      }
    },
    "sequence": {
      "model": "JC69",
      "params": {
        "mutation_rate": 0.1,
        "num_classes": 4,
        "seed": 42
      }
    },
    "partition": {
      "num_gaps": 1,
      "min_split": 2
    }
  },
  "sweep": {
    "parameter": "sequence.len",
    "values": [500, 1000, 2000, 5000]
  },
  "output": {
    "dir": "results/comparisons/seq_length_scaling",
    "save_individual_matrices": false
  }
}

